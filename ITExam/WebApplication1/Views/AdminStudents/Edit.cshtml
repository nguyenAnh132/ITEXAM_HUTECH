@using ITExam.ViewModels.Admin
@model StudentEditVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sửa sinh viên";
}

<div class="container-fluid px-4 py-4">
    <h2>Sửa sinh viên</h2>

    <form asp-controller="AdminStudents" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <div class="row">
            <div class="col-12 col-md-6 mb-3">
                <label class="form-label fw-bold">Username</label>
                <input asp-for="Username" class="form-control" readonly />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6 mb-3">
                <label class="form-label fw-bold">Họ tên</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label class="form-label fw-bold">Email (tuỳ chọn)</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6 mb-3">
                <label class="form-label fw-bold">Khoa (tuỳ chọn)</label>
                <input asp-for="Faculty" class="form-control" />
                <span asp-validation-for="Faculty" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label fw-bold">Mật khẩu mới (tuỳ chọn)</label>
            <input asp-for="NewPassword" type="password" class="form-control" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-controller="AdminStudents" asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>

    <hr class="my-4" />

    <h4>Reset mật khẩu (bắt buộc nhập)</h4>
    <form asp-controller="AdminStudents" asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="UserId" value="@Model.UserId" />

        <div class="row align-items-end">
            <div class="col-12 col-md-6 mb-3">
                <label class="form-label fw-bold">Mật khẩu mới</label>
                <input type="password" name="NewPassword" class="form-control" />
                @* validation message handled server-side via TempData *@
            </div>
            <div class="col-12 col-md-6 mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-warning w-100">Reset</button>
            </div>
        </div>
    </form>
</div>

<partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />


@model ITExam.ViewModels.RegisterVM

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="shortcut icon" href="~/img/itexam.png" type="image/x-icon">
    <link rel="stylesheet" href="~/css/login-style.css">
</head>
<body>
    <main class="px-3">
        <div class="container-login">
            <div class="right-section">
                <div class="login-small-container">
                    <h3 class="text-center mb-3">Đăng ký (Student)</h3>

                    <form class="login-form" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="text-danger mb-2 fz-2 text-center">
                                @foreach (var state in ViewData.ModelState.Values)
                                {
                                    foreach (var error in state.Errors)
                                    {
                                        <div>@error.ErrorMessage</div>
                                    }
                                }
                            </div>
                        }

                        <div class="form-control-login">
                            <i class="fas fa-user icon"></i>
                            <input asp-for="Username" id="username" placeholder="Tên tài khoản" required />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="form-control-login">
                            <i class="fas fa-id-badge icon"></i>
                            <input asp-for="FullName" id="fullname" placeholder="Họ tên" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="form-control-login">
                            <i class="fas fa-lock icon"></i>
                            <input asp-for="Password" type="password" id="password" placeholder="Mật khẩu" required />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button class="btn-login" type="submit">Tạo tài khoản</button>

                        <div class="text-center mt-2">
                            <a asp-controller="Auth" asp-action="Login">Quay lại đăng nhập</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>


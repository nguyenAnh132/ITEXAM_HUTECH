@model ITExam.ViewModels.Exam.EssaySubmissionToGradeVM

@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "Chấm điểm chi tiết";
}
@section Style {
    <style>
        /* Tạo nền xám nhẹ cho toàn trang để nổi bật các Card */
        body {
            background-color: #fff;
        }

        .student-info-card {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            border: none;
            border-radius: 12px;
        }

        .chapter-header {
            position: relative;
            padding-left: 15px;
            margin-top: 30px;
            margin-bottom: 20px;
        }

        .question-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.05);
            transition: transform 0.2s;
            overflow: hidden;
        }

        /* Vùng hiển thị bài làm sinh viên giả lập trang giấy */
        .student-answer-box {
            background-color: #fff;
            border: 1px solid #e9ecef;
            border-radius: 6px;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #212529;
            line-height: 1.6;
        }

        /* Hiệu ứng focus cho ô nhập điểm */
        .total-score-input:focus {
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
            border-color: #dc3545;
        }

        /* Sticky panel cho cột chấm điểm trên màn hình lớn */
        @@media (min-width: 992px) {
            .grading-panel

        {
            position: -webkit-sticky;
            position: sticky;
            top: 20px; /* Cách mép trên 20px */
            max-height: 90vh;
            overflow-y: auto;
        }

        }

        /* Responsive cho mobile */
        @@media (max-width: 991.98px) {
            .grading-panel

        {
            margin-top: 20px;
            border-top: 1px dashed #dee2e6;
            padding-top: 20px;
        }

        }

        .criteria-row:hover {
            background-color: #f8f9fa;
        }
    </style>
}
<div class="container-xl py-4">
    <div class="card student-info-card text-white mb-5 shadow">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h6 class="text-white text-uppercase mb-1">Chấm bài tự luận</h6>
                    <h3 class="fw-bold mb-1 text-white">@Model.ExamTitle</h3>
                    <div class="d-flex flex-wrap gap-3 mt-3">
                        <span class="badge bg-white text-primary rounded-pill px-3 py-2">
                            <i class="fa-solid fa-user me-1"></i> @Model.FullName (@Model.StudentID)
                        </span>
                        <span class="badge bg-white text-secondary rounded-pill px-3 py-2">
                            <i class="fa-solid fa-clock me-1"></i> @(Model.SubmissionTime?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa nộp")
                        </span>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    @if (!string.IsNullOrEmpty(Model.UploadedFileLink))
                    {
                        <a href="@Model.UploadedFileLink" target="_blank" class="btn bg-white fw-bold shadow-sm">
                            <i class="fa-solid fa-file-arrow-down me-2"></i>Tải bài làm
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <form asp-action="SaveGradingResult" asp-controller="Teacher" method="post" id="gradingForm">
        <input type="hidden" asp-for="HistoryId" />
        <input type="hidden" asp-for="ExamId" />
        <input type="hidden" asp-for="ClassId" />

        @{
            int globalIndex = 0;
        }

        @foreach (var chapterGroup in Model.ListQuestions.GroupBy(x => new { x.ChapterId, x.ChapterTitle }))
        {
            <div class="chapter-header">
                <h4 class="text-primary fw-bold mb-0">@chapterGroup.Key.ChapterTitle</h4>
            </div>

            @foreach (var cloGroup in chapterGroup.GroupBy(x => new { x.CloId, x.CloTitle }))
            {
                <div class="mb-4">
                    <h6 class="text-muted fw-bold text-uppercase ms-3 mb-3" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                        <i class="fa-solid fa-layer-group me-1"></i> @cloGroup.Key.CloTitle
                    </h6>

                    @foreach (var question in cloGroup)
                    {
                        <input type="hidden" name="ListQuestions[@globalIndex].QuestionId" value="@question.QuestionId" />

                        <div class="card question-card mb-5" id="question-block-@globalIndex">
                            <div class="card-body p-0">
                                <div class="row g-0">
                                    <div class="col-lg-8 p-4 border-end-lg">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <span class="badge bg-primary bg-opacity-10 text-white px-3 py-2 rounded-pill fw-bold">
                                                Câu hỏi @(globalIndex + 1)
                                            </span>
                                        </div>

                                        <div class="mb-4">
                                            <h5 class="lh-base text-dark">@Html.Raw(question.QuestionContent)</h5>
                                        </div>

                                        <div class="mt-4">
                                            <label class="text-success fw-bold mb-2 small text-uppercase">
                                                <i class="fa-solid fa-pen-nib me-1"></i> Bài làm của sinh viên
                                            </label>
                                            <div class="student-answer-box shadow-sm">
                                                @if (string.IsNullOrEmpty(question.StudentAnswer))
                                                {
                                                    <div class="text-center text-muted py-3 fst-italic">
                                                        <i class="fa-solid fa-ban mb-2 d-block fa-2x opacity-25"></i>
                                                        Sinh viên không trả lời câu hỏi này.
                                                    </div>
                                                }
                                                else
                                                {
                                                    @Html.Raw(question.StudentAnswer)
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 bg-light bg-opacity-25">
                                        <div class="p-4 grading-panel">
                                            <div class="bg-white p-3 rounded-3 shadow-sm border">
                                                <label class="form-label fw-bold text-danger d-flex justify-content-between">
                                                    <span>ĐIỂM TỔNG KẾT</span>
                                                    <span class="badge bg-danger bg-opacity-10 text-white d-flex align-items-center">Tối đa: @question.MaxScore</span>
                                                </label>

                                                <div class="input-group input-group-lg mb-2">
                                                    <input type="number"
                                                           class="form-control fw-bold text-center text-danger total-score-input"
                                                           name="ListQuestions[@globalIndex].GradedScore"
                                                           value="@question.GradedScore"
                                                           step="0.1" min="0" max="@question.MaxScore"
                                                           data-index="@globalIndex"
                                                           id="total-score-@globalIndex"
                                                           placeholder="0">
                                                    <span class="input-group-text bg-white fw-bold text-muted">/ @question.MaxScore</span>
                                                </div>
                                                <small class="text-muted d-block text-center fst-italic" style="font-size: 0.8rem">
                                                    Nhập trực tiếp hoặc chấm theo tiêu chí dưới đây
                                                </small>
                                            </div>

                                            @if (question.Criteria != null && question.Criteria.Any())
                                            {
                                                <div class="mt-4">
                                                    <h6 class="fw-bold text-secondary mb-3 small text-uppercase border-bottom pb-2">
                                                        Tiêu chí chấm điểm
                                                    </h6>
                                                    <div class="d-flex flex-column gap-2">
                                                        @foreach (var crit in question.Criteria)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between p-2 rounded criteria-row bg-white border border-light shadow-sm">
                                                                <div class="me-2" style="font-size: 0.9rem; line-height: 1.3;">
                                                                    <span class="d-block fw-semibold text-dark">@crit.Content</span>
                                                                    <span class="text-muted small">Trọng số: @(crit.Rate * 100)%</span>
                                                                </div>
                                                                <div style="width: 80px;">
                                                                    <input type="number"
                                                                           class="form-control form-control-sm text-center fw-bold text-primary criteria-input border-0 bg-light"
                                                                           placeholder="0"
                                                                           step="0.1" min="0" max="@crit.MaxPoint"
                                                                           data-parent-index="@globalIndex"
                                                                           title="Max: @crit.MaxPoint">
                                                                    <div class="text-center text-muted" style="font-size: 0.65rem;">Max: @crit.MaxPoint</div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="alert alert-light border mt-3 d-flex align-items-center text-muted">
                                                    <i class="fa-solid fa-circle-info me-2"></i>
                                                    <small>Không có tiêu chí phụ.</small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        globalIndex++;
                    }
                </div>
            }
        }

        <div class="fixed-bottom bg-white border-top shadow-lg p-3">
            <div class="container-xl d-flex justify-content-between align-items-center">
                <div class="text-muted d-none d-md-block">
                    <small><i class="fa-solid fa-keyboard me-1"></i> Bạn có thể nhập điểm nhanh bằng phím Tab</small>
                </div>
                <div>
                    <a asp-action="Grading_The_Exam" asp-route-maDe="@Model.ExamId" asp-route-maLop="@Model.ClassId" class="btn btn-outline-secondary me-2 px-4 fw-bold">
                        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu kết quả
                    </button>
                </div>
            </div>
        </div>
    </form>

    <div style="height: 100px;"></div>
</div>

@section Script {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const criteriaInputs = document.querySelectorAll('.criteria-input');

            criteriaInputs.forEach(input => {
                input.addEventListener('input', function() {
                    const parentIndex = this.getAttribute('data-parent-index');
                    updateTotalScore(parentIndex);
                });
            });

            function updateTotalScore(index) {
                const block = document.getElementById(`question-block-${index}`);
                if(!block) return;

                const cInputs = block.querySelectorAll('.criteria-input');
                let sum = 0;

                cInputs.forEach(inp => {
                    let val = parseFloat(inp.value);
                    if (isNaN(val)) val = 0;
                    sum += val;
                });

                sum = Math.round(sum * 100) / 100;

                const totalInput = document.getElementById(`total-score-${index}`);
                if (totalInput) {
                    const max = parseFloat(totalInput.getAttribute('max'));
                    if (sum > max) sum = max;

                    totalInput.value = sum;

                    // Hiệu ứng Visual: Đổi màu border nhẹ để báo hiệu cập nhật
                    totalInput.style.borderColor = "#198754"; // Xanh lá
                    setTimeout(() => {
                        totalInput.style.borderColor = ""; // Reset
                    }, 500);
                }
            }

            // Validation Logic
            const allNumberInputs = document.querySelectorAll('input[type="number"]');
            allNumberInputs.forEach(inp => {
                inp.addEventListener('change', function() {
                    let val = parseFloat(this.value);
                    let max = parseFloat(this.getAttribute('max'));
                    let min = parseFloat(this.getAttribute('min'));

                    if (val > max) {
                        // Dùng Toast hoặc Alert đẹp hơn thay vì alert mặc định trình duyệt nếu muốn
                        // Ở đây giữ simple alert nhưng reset giá trị
                        alert(`Điểm không được vượt quá ${max}`);
                        this.value = max;
                         // Trigger lại tính toán nếu cần
                        if(this.classList.contains('criteria-input')){
                             updateTotalScore(this.getAttribute('data-parent-index'));
                        }
                    }
                    if (val < min) {
                        this.value = min;
                         if(this.classList.contains('criteria-input')){
                             updateTotalScore(this.getAttribute('data-parent-index'));
                        }
                    }
                });
            });
        });
    </script>
}
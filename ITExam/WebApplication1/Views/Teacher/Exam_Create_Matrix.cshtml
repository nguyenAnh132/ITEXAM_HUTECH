@using ITExam.ViewModels.Exam
@using Newtonsoft.Json
@model ExamMatrixVM
@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "Tạo đề thi";
}
@section Style {
    <link rel="stylesheet" href="~/css/teacher-create-exam-matrix.css" />
}
<div class="container-fluid pt-2">
    <div class="pt-3 py-lg-0 px-lg-5 px-1">
        <div class="row mx-0 justify-content-center pt-2">
            <div class="col-lg-6">
                <div class="section-title text-center position-relative mb-4">
                    <h2 class="display-4">Ma trận đề thi</h2>
                    <h6 class="d-inline-block position-relative text-secondary text-uppercase pb-2">Môn học: @ViewBag.SubjectName</h6>
                </div>
            </div>
        </div>
        <div class="pt-3 py-lg-0 px-lg-5 px-3">
            <div class="d-flex justify-content-end mb-3">
                <a class="btn btn-danger" asp-controller="Teacher" asp-action="Exam">Trở về</a>
            </div>

            <form id="editExamForm" method="post" asp-action="EditExam" asp-controller="Teacher" class="m-1">
                <div class="bg-white p-3 rounded shadow mb-3">
                    <input type="hidden" name="MaDe" value="@Model.ExamId" />

                    <div class="modal-body row">
                        <div class="mb-2 col-lg-9">
                            <label class="form-label fw-bold">Tên đề thi</label>
                            <input name="TenDeThi" class="form-control fs-6"
                                   id="tenDeThiInput"
                                   value="@Model.ExamName"
                                   data-original="@Model.ExamName" />
                        </div>
                        <div class="mb-2 col-lg-3">
                            <label class="form-label fw-bold">Thời gian làm bài</label>
                            <input type="number" name="ThoiGianLamBai"
                                   class="form-control fs-6"
                                   id="thoiGianInput"
                                   value="@Model.Duration"
                                   data-original="@Model.Duration" />
                        </div>
                    </div>

                    <div class="modal-footer row p-2">
                        <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
                            Cập nhật thông tin đề thi
                        </button>
                    </div>
                </div>
            </form>
            <div class="">
                <div class="tab-content mt-3">
                    <div class="tab-pane active" id="create" role="tabpanel" aria-labelledby="create-tab">
                        <div class="row">
                            <div class="col-12 col-xl-9 mb-2">
                                <div class="bg-white p-3 rounded shadow">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <button class="rounded-circle btn btn-primary my-2" id="btn-add-chuong"
                                                style="width: 50px; height: 50px">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                        <button class="btn btn-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalInstruct"
                                                style="width: 50px; height: 50px">
                                            <i class="fa-solid fa-info"></i>
                                        </button>
                                    </div>
                                    <div id="chuong-container" class="my-3">
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-xl-3 mb-3 mb-md-0">
                                <div class="bg-white p-3 rounded shadow">
                                    <h5 class="fw-bold">Thông tin đề thi</h5>
                                    <div id="summary-chuong-cauhoi" class="mt-3"></div>
                                    <hr />
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-semibold">Tổng số câu hỏi:</span>
                                        <span class="fw-bold text-primary" id="tong-so-cau">0</span>
                                    </div>
                                    <button class="btn btn-primary w-100 mt-3" onclick="submitMatrix()">
                                        Lưu ma trận
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Modal {
    <div class="modal fade" id="modalInstruct" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary">
                    <h1 class="modal-title fs-5 text-white" id="exampleModalLabel">Thao tác tạo ma trận đề thi</h1>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <div class="mb-3">
                        <span class="badge bg-primary me-2">1</span>
                        Nhấn nút <strong>+</strong> để thêm chương vào ma trận.
                    </div>

                    <div class="mb-3">
                        <span class="badge bg-primary me-2">2</span>
                        Chọn <strong>chương</strong> cần tạo câu hỏi.
                    </div>

                    <div class="mb-3">
                        <span class="badge bg-primary me-2">3</span>
                        Nhập số lượng câu hỏi cho từng <strong>CLO</strong>.
                    </div>

                    <div class="mb-3">
                        <span class="badge bg-primary me-2">4</span>
                        Có thể thêm nhiều chương tùy ý.
                    </div>

                    <div class="mb-3">
                        <span class="badge bg-primary me-2">5</span>
                        Kiểm tra tổng số câu hỏi ở bảng bên phải.
                    </div>

                    <div class="mb-3">
                        <span class="badge bg-success me-2">✔</span>
                        Nhấn <strong>Lưu ma trận đề thi</strong> để hoàn tất.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Đã hiểu</button>
                </div>
            </div>
        </div>
    </div>
}
@section Script {
    <script src="~/js/notification.js"></script>
    <script>
        const chuongData = @Html.Raw(ViewData["ChapterJson"]);
        let isEssayExam = @(Model.IsEssayExam.ToString().ToLower());
        let index = 0;

        // --- 1. SỰ KIỆN THÊM MỚI (GIỮ NGUYÊN LOGIC CŨ) ---
        document.getElementById('btn-add-chuong').addEventListener('click', function () {
            const container = document.getElementById('chuong-container');
            const rowId = `row-${index++}`;

            let html = `
                <div class="border p-3 rounded mb-3" id="${rowId}">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <select class="form-select chuong-select" style="width: 70%">
                            <option value="" disabled selected hidden>-- Chọn chương --</option>
                        </select>
                        <button class="btn btn-danger" onclick="xoaDongChuong('${rowId}')">
                            <i class="fa fa-trash"></i>
                        </button>
                    </div>
                    <div class="clo-list"></div>
                </div>`;

            container.insertAdjacentHTML('beforeend', html);
            capNhatDanhSachChuongComboBox();
        });

        document.addEventListener('change', function (e) {
            if (e.target.classList.contains('chuong-select')) {
                const ChapterId = e.target.value;
                const Chapter = chuongData.find(c => c.ChuongId == ChapterId);
                const cloListContainer = e.target.closest('.border').querySelector('.clo-list');

                if (!Chapter) return;

                let cloHTML = '';

                Chapter.Clos.forEach(clo => {
                    cloHTML += createCountInputHtml(clo.CLOTitle, 0, clo.MaxQuestionCount, clo.CLOId);
                });

                if (isEssayExam) {
                    cloHTML += startPointSectionHtml();
                    Chapter.Clos.forEach(clo => {

                        cloHTML += createPointInputHtml(ChapterId, clo.CLOTitle, 0, clo.CLOId, true);
                    });
                    cloHTML += endPointSectionHtml();
                }

                cloListContainer.innerHTML = cloHTML;
                capNhatThongTinCauHoi();
                capNhatDanhSachChuongComboBox();
                if(isEssayExam) validateTotalPoints();
            }
        });

        document.addEventListener('input', function (e) {
            const row = e.target.closest('.js-clo-row');

            if (row && !e.target.matches('.clo-point-input')) {
                const cloId = row.querySelector('.clo-id').value;
                const sl = parseInt(e.target.value) || 0;
                const chapterContainer = row.closest('[id^="row-"]');

                const selectBox = chapterContainer.querySelector('.chuong-select');
                const chapterId = selectBox ? selectBox.value : null;

                if (chapterId) {
                    const wrapper = chapterContainer.querySelector(`.clo-point-wrapper[data-chapter-id="${chapterId}"][data-clo-id="${cloId}"]`);

                    if (wrapper) {
                        const input = wrapper.querySelector('input');
                        if (sl > 0) {
                            wrapper.classList.remove('d-none');
                        } else {
                            wrapper.classList.add('d-none');
                            if (input) input.value = 0;
                        }
                        validateTotalPoints(); 
                    }
                }
            }

            if (e.target.matches('.clo-point-input')) {
                validateTotalPoints();
            }
        });

        window.addEventListener('DOMContentLoaded', () => {
            const danhSachDaLuu = @Html.Raw(JsonConvert.SerializeObject(Model.Chapters));
            const container = document.getElementById('chuong-container');

            danhSachDaLuu.forEach(savedChuong => {
                if (!savedChuong) return;
                const realChapter = chuongData.find(c => c.ChuongId == savedChuong.ChapterId);
                if (!realChapter) return;

                const cloCoSoLuong = savedChuong.CLOs.filter(c => c.QuestionCount > 0);
                if (cloCoSoLuong.length === 0) return;

                const rowId = `row-${index++}`;


                let html = `
                    <div class="border p-3 rounded mb-3" id="${rowId}">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <select class="form-select chuong-select" style="width: 70%">
                                <option value="" disabled hidden>-- Chọn chương --</option>
                            </select>
                            <button class="btn btn-danger" onclick="xoaDongChuong('${rowId}')">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                        <div class="clo-list">`;
                savedChuong.CLOs.forEach(savedClo => {
                    const realClo = realChapter.Clos.find(c => c.CLOId == savedClo.CLOId);
                    if (realClo) {
                        const currentMax = realClo.MaxQuestionCount;
                        let currentCount = savedClo.QuestionCount;
                        if (currentCount > currentMax) currentCount = currentMax;

                        html += createCountInputHtml(realClo.CLOTitle, currentCount, currentMax, savedClo.CLOId);
                    }
                });

                if (isEssayExam) {
                    html += startPointSectionHtml();

                    savedChuong.CLOs.forEach(savedClo => {
                         const realClo = realChapter.Clos.find(c => c.CLOId == savedClo.CLOId);
                        if (realClo) {
                            const savedPoint = savedClo.CloScore || 0;
                            const isHidden = savedClo.QuestionCount <= 0;

                            html += createPointInputHtml(savedChuong.ChapterId, realClo.CLOTitle, savedPoint, savedClo.CLOId, isHidden);
                        }
                    });

                    html += endPointSectionHtml();
                }

                html += `</div></div>`;

                container.insertAdjacentHTML('beforeend', html);

                const select = document.getElementById(rowId).querySelector('.chuong-select');
                chuongData.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.ChuongId;
                    opt.textContent = c.TenChuong;
                    select.appendChild(opt);
                });
                select.value = savedChuong.ChapterId;
            });

            capNhatDanhSachChuongComboBox();
            capNhatThongTinCauHoi();
            if(isEssayExam) validateTotalPoints();

            const submitBtn = document.getElementById("submitBtn");
            const inputs = document.querySelectorAll("#editExamForm input");
            const checkChanges = () => {
                let changed = false;
                inputs.forEach(input => {
                     if (input.getAttribute("data-original") !== null && input.value !== input.getAttribute("data-original")) changed = true;
                });
                if(submitBtn) submitBtn.disabled = !changed;
            };
            inputs.forEach(input => input.addEventListener("input", checkChanges));
        });


        function createCountInputHtml(title, count, max, cloId) {
            return `
            <div class="my-2 d-flex gap-3 align-items-center js-clo-row">
                <input value="${title}" disabled type="text" class="form-control flex-grow-1" />
                <input style="width: 7rem;" type="number" value="${count}"
                       class="form-control clo-count" placeholder="Số lượng"
                       min="0" max="${max}" ${max === 0 ? "disabled" : ""} title="Tối đa ${max} câu hỏi"/>
                <span class="text-muted text-nowrap">(Tối đa ${max})</span>
                <input type="hidden" value="${cloId}" class="clo-id" />
            </div>`;
        }

        function startPointSectionHtml() {
            return `
            <div class="mt-4 mb-3 position-relative border-opacity-25 rounded p-3 bg-light bg-opacity-10">
                <span class="position-absolute top-0 start-0 translate-middle-y ms-3 px-2 bg-white text-primary fw-bold small shadow-sm border-opacity-10 rounded">
                    Cấu hình điểm chi tiết
                </span>
                <div class="row g-2">`;
        }

        function createPointInputHtml(chapterId, title, point, cloId, isHidden) {
            return `
            <div class="col-6 col-md-3 clo-point-wrapper ${isHidden ? 'd-none' : ''}"
                 id="point-wrapper-${chapterId}_${cloId}"
                 data-chapter-id="${chapterId}"
                 data-clo-id="${cloId}">
                <div class="border rounded p-2 bg-white h-100 shadow-sm">
                    <label class="form-label small text-muted mb-1 text-truncate w-100 fw-bold" title="${title}">
                        ${title}
                    </label>
                    <div class="input-group input-group-sm">
                        <input type="number"
                               class="form-control clo-point-input fw-bold text-primary text-center"
                               placeholder="0"
                               min="0"
                               step="0.5"
                               value="${point}"
                               data-clo-id="${title}_${cloId}">
                        <span class="input-group-text px-2">điểm</span>
                    </div>
                </div>
            </div>`;
        }

        function endPointSectionHtml() {
            return `</div>
                <div class="text-center text-muted small fst-italic mt-2 empty-point-notice" style="display:none">
                    (Nhập số lượng câu hỏi để hiện ô điểm)
                </div>
            </div>`;
        }

        function togglePointInput(chapterId, cloId, soLuong) {

            const wrapper = document.getElementById(`point-wrapper-${chapterId}_${cloId}`);
            if (wrapper) {
                const input = wrapper.querySelector('input');
                if (soLuong > 0) {
                    wrapper.classList.remove('d-none');
                } else {
                    wrapper.classList.add('d-none');
                    if(input) input.value = 0;
                }
                validateTotalPoints();
            }
        }

        function validateTotalPoints() {
            if (!isEssayExam) return;

            const allPointInputs = document.querySelectorAll('.clo-point-input');
            let totalScore = 0;
            let hasEmptyInput = false; 

            allPointInputs.forEach(inp => {
                if (!inp.closest('.d-none')) {
                    const valStr = inp.value.trim();

                    if (valStr === '' ||valStr === '0') {
                        hasEmptyInput = true;
                        inp.classList.add('is-invalid'); 
                    } else {
                        inp.classList.remove('is-invalid'); 
                    }

                    totalScore += parseFloat(valStr) || 0;
                }
            });

            totalScore = Math.round(totalScore * 100) / 100;

            const btnSave = document.querySelector('button[onclick="submitMatrix()"]');
            if (btnSave) {
                if (totalScore === 10 && !hasEmptyInput) {
                    btnSave.disabled = false;
                    btnSave.innerHTML = `<i class="fa-solid fa-check me-1"></i> Lưu ma trận`;
                    btnSave.classList.remove('btn-secondary');
                    btnSave.classList.add('btn-primary');
                } else {
                    btnSave.disabled = true;
                    btnSave.classList.remove('btn-primary');
                    btnSave.classList.add('btn-secondary');

                    if (hasEmptyInput) {
                        btnSave.innerHTML = `Vui lòng nhập đủ điểm`;
                    } else {
                        btnSave.innerHTML = `Tổng: ${totalScore}/10`;
                    }
                }
            }
        }

        function submitMatrix() {
            const chuongContainers = document.querySelectorAll('#chuong-container > .border');
            const matrix = [];
            let hasError = false;

            chuongContainers.forEach(ch => {
                const chuongSelect = ch.querySelector('.chuong-select');
                const ChapterId = parseInt(chuongSelect.value || 0);
                const ChapterTitle = chuongSelect.options[chuongSelect.selectedIndex]?.textContent || "";

                const cloInputs = ch.querySelectorAll('.clo-list .js-clo-row');

                const cloData = Array.from(cloInputs).map(div => {
                    const CLO = div.querySelector('input[type="text"]').value;
                    const CLOId = parseInt(div.querySelector('.clo-id').value || 0);
                    const count = parseInt(div.querySelector('.clo-count').value || 0);
                    const max = parseInt(div.querySelector('.clo-count').getAttribute('max'));

                    let point = 0;
                    if(isEssayExam) {
                        const pInput = ch.querySelector(`#point-wrapper-${ChapterId}_${CLOId} input`);
                        if(pInput && !pInput.closest('.d-none')) point = parseFloat(pInput.value) || 0;
                    }

                    if (count > max) { showToast(`Số lượng câu hỏi "${CLO}" không được vượt quá ${max}`, "#dc3545"); hasError = true; }
                    if (count < 0) { showToast("Số lượng không được âm", "#dc3545"); hasError = true; }

                    return { CLOId, CLO, QuestionCount: count, CloScore: point };
                }).filter(c => c.QuestionCount > 0);

                if (ChapterId > 0 && cloData.length > 0) {
                    matrix.push({ ChapterId, Chuong: ChapterTitle, CLOs: cloData });
                }
            });

            if (hasError) return;

            if(isEssayExam) {
                let finalTotal = 0;
                matrix.forEach(chap => chap.CLOs.forEach(c => finalTotal += c.CloScore));
                if(Math.round(finalTotal * 100)/100 !== 10) {
                    showToast(`Tổng điểm ${finalTotal} != 10`, "#dc3545"); return;
                }
            }

            const data = { ExamId: @Model.ExamId, Chapters: matrix };
            fetch('/Teacher/Save_Exam_Matrix', {
                method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast("Đã lưu thay đổi!", "#28a745");
                    setTimeout(() => window.location.href = "/Teacher/Exam_Create_Matrix/" + data.deThiId, 1000);
                } else showToast("Lỗi lưu.", "#dc3545");
            })
            .catch(() => showToast("Lỗi kết nối.", "#dc3545"));
        }

        function xoaDongChuong(rowId) {
            document.getElementById(rowId).remove();
            capNhatDanhSachChuongComboBox();
            capNhatThongTinCauHoi();
            if(isEssayExam) validateTotalPoints();
        }
        function capNhatDanhSachChuongComboBox() {
            const daChon = Array.from(document.querySelectorAll('.chuong-select')).map(s=>s.value).filter(v=>v && v!=='-- Chọn chương --');
            document.querySelectorAll('.chuong-select').forEach(sel => {
                const cur = sel.value; sel.innerHTML = '<option value="" disabled selected hidden>-- Chọn chương --</option>';
                chuongData.forEach(c => {
                    if(!daChon.includes(c.ChuongId.toString()) || c.ChuongId.toString()===cur) {
                        const opt = document.createElement('option'); opt.value=c.ChuongId; opt.textContent=c.TenChuong;
                        if(cur===c.ChuongId.toString()) opt.selected=true; sel.appendChild(opt);
                    }
                });
            });
        }
        function capNhatThongTinCauHoi() {
            const sumContainer = document.getElementById('summary-chuong-cauhoi');
            const sumSpan = document.getElementById('tong-so-cau');
            sumContainer.innerHTML = ''; let total=0;
            document.querySelectorAll('#chuong-container > .border').forEach(div => {
                const name = div.querySelector('.chuong-select option:checked')?.textContent;
                let subTotal=0;
                div.querySelectorAll('.clo-count').forEach(inp => subTotal += parseInt(inp.value)||0);
                if(name && subTotal>0) {
                    sumContainer.insertAdjacentHTML('beforeend', `<div class="d-flex justify-content-between mb-2"><span>${name}</span><fw-bold>${subTotal} câu</fw-bold></div>`);
                }
                total+=subTotal;
            });
            sumSpan.textContent = total;
        }
        function showToast(message, color) {
                Toastify({
                    text: message,
                    duration: 4000,
                    close: true,
                    gravity: "bottom",
                    position: "right",
                    stopOnFocus: true,
                    style: { background: color }
                }).showToast();
            }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const submitBtn = document.getElementById("submitBtn");
            const inputs = document.querySelectorAll("#editExamForm input");

            function checkChanges() {
                let changed = false;

                inputs.forEach(input => {
                    const original = input.getAttribute("data-original");
                    if (original !== null && input.value !== original) {
                        changed = true;
                    }
                });

                submitBtn.disabled = !changed;
            }

            inputs.forEach(input => {
                input.addEventListener("input", checkChanges);
            });

            checkChanges();
        });
    </script>
}
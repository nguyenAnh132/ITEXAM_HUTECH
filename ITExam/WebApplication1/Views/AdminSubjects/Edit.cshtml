@using ITExam.ViewModels.Admin
@model SubjectEditVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sửa môn học";
}

<div class="container-fluid px-4 py-4">
    <h2>Sửa môn học</h2>

    <form asp-controller="AdminSubjects" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-12 col-md-6 mb-3">
                <label class="form-label fw-bold">Mã môn</label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6 mb-3">
                <label class="form-label fw-bold">Tên môn</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-controller="AdminSubjects" asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>

<partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />


@using ITExam.ViewModels.Admin
@model CloEditVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sửa CLO";
}

<div class="container-fluid px-4 py-4">
    <h2>Sửa CLO</h2>

    <form asp-controller="AdminSubjects" asp-action="EditClo" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CloId" />

        <div class="mb-3">
            <label class="form-label fw-bold">Tiêu đề CLO</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Mô tả (tuỳ chọn)</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-controller="AdminSubjects" asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>

<partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />

